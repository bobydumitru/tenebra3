# Testnet/devnet RPC configuration for safe transfer rehearsals.
# Fill provider keys only in a protected shell; never commit real secrets.

TENEBRA_BRIDGE_ENVIRONMENT=testnet

TENEBRA_SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
TENEBRA_SOLANA_TESTNET_RPC_KEY=

# Use a Sepolia JSON-RPC provider with eth_sendRawTransaction enabled.
TENEBRA_EVM_TESTNET_RPC_URL=https://sepolia.example-rpc.invalid
TENEBRA_EVM_TESTNET_RPC_KEY=

# Use a Bitcoin Signet/Testnet Core-compatible JSON-RPC node.
TENEBRA_BITCOIN_TESTNET_RPC_URL=http://127.0.0.1:18332
TENEBRA_BITCOIN_TESTNET_RPC_KEY=
