# Mainnet node configuration template. Keep private operator values outside the repository.
TENEBRA_MAINNET_BLOCKS_DIR=/var/lib/tenebra-mainnet-candidate/blocks
TENEBRA_MAINNET_MINER_ADDRESS_FILE=/var/lib/tenebra-mainnet-candidate/miner-address
TENEBRA_MAINNET_SEEDS=
TENEBRA_MAINNET_PEERS=
# Optional legacy single miner. The address file above supports concurrent wallets.
# Never put a wallet password, seed or spend key here.
# TENEBRA_MAINNET_MINER_ADDRESS=tsc1_<public-address>
