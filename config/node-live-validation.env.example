# Complete node configuration template for a controlled validation network.
# Copy this file to a protected environment file on the host and fill in the real values.
# Do not commit the filled file to the repository.

# 32-byte private key for this node in lowercase hex.
TSC1_DEVNET_V3_PEER_KEY=<64-lowercase-hex-private-seed>

# Allowlisted public keys for the authorized peer set.
# Include this node's public key and all trusted peers.
TSC1_DEVNET_V3_PEER_KEYS=<64-hex-public-key-node-1>,<64-hex-public-key-node-2>

# Bootstrap addresses used for initial peer discovery.
TSC1_DEVNET_V3_SEEDS=seed1.example.com:39453,seed2.example.com:39453

# Optional static peers beyond the seeds.
TSC1_DEVNET_V3_PEERS=

# Absolute path to the block data directory for this node.
# Suggested for Linux: /var/lib/tenebra-v3f/blocks
# Suggested for Windows: C:\\srv\\tenebra\\blocks
TSC1_DEVNET_V3_BLOCKS_DIR=/var/lib/tenebra-v3f/blocks
