# RPC endpoints for the real cross-chain executor.
# Copy to a protected runtime environment; never commit filled secrets.
# The executor accepts only already-signed raw transactions.

TENEBRA_BRIDGE_ENVIRONMENT=testnet
# Mainnet requires an explicit TENEBRA_BRIDGE_ALLOW_MAINNET=true after testnet validation.

TENEBRA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TENEBRA_SOLANA_RPC_KEY=

# Use an Ethereum/EVM JSON-RPC provider with eth_sendRawTransaction enabled.
TENEBRA_EVM_RPC_URL=https://cloudflare-eth.com
TENEBRA_EVM_RPC_KEY=

# Use a Bitcoin Core-compatible JSON-RPC endpoint. Public explorer APIs are not sufficient.
TENEBRA_BITCOIN_RPC_URL=http://127.0.0.1:8332
TENEBRA_BITCOIN_RPC_KEY=

# Example commands after loading this file in a protected shell:
# cargo run --bin tenebra-bridge -- broadcast solana <operation-id> <signed-base64-tx> SOL <amount> <owner> credit
# cargo run --bin tenebra-bridge -- broadcast evm <operation-id> <signed-0x-raw-tx> ETH <amount> <owner> debit
# cargo run --bin tenebra-bridge -- broadcast bitcoin <operation-id> <signed-raw-tx-hex> BTC <amount> <owner> credit
