# SOL <-> TENEBRA bridge configuration
# Keep disabled until the Solana program and multisig custody are independently verified.
TENEBRA_SOLANA_BRIDGE_ENABLED=false
TENEBRA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Deployed Solana program ID. Leave empty until a reviewed program exists.
TENEBRA_SOLANA_BRIDGE_PROGRAM_ID=
# SPL mint representing locked SOL on TENEBRA. Leave empty until the mint is controlled by the bridge.
TENEBRA_SOLANA_TSOL_MINT=
# Multisig/vault public key that receives SOL deposits. Never put a private key here.
TENEBRA_SOLANA_VAULT_ADDRESS=
# Minimum finalized confirmations required before a deposit can be credited.
TENEBRA_SOLANA_MIN_CONFIRMATIONS=32
