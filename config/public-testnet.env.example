# Copy to a protected environment file on each VPS. Never commit the filled file.
# Generate a unique 32-byte Ed25519 seed for every node and keep it private.
TSC1_DEVNET_V3_PEER_KEY=<64-lowercase-hex-private-seed>
# Comma-separated public keys of all authorized nodes, including this node.
TSC1_DEVNET_V3_PEER_KEYS=<64-hex-public-key-node-1>,<64-hex-public-key-node-2>
# DNS names or host:port addresses of bootstrap nodes.
TSC1_DEVNET_V3_SEEDS=seed1.tenebra-network.com:39453,seed2.tenebra-network.com:39453
# Additional static peers are optional.
TSC1_DEVNET_V3_PEERS=
TSC1_DEVNET_V3_BLOCKS_DIR=/var/lib/tenebra-v3f/blocks
