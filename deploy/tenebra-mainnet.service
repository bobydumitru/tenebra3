[Unit]
Description=TENEBRA public mainnet node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tenebra
Group=tenebra
WorkingDirectory=/opt/tenebra
EnvironmentFile=/etc/tenebra/mainnet.env
ExecStart=/opt/tenebra/bin/tenebra-node serve 0.0.0.0:39453
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/tenebra/mainnet.log
StandardError=append:/var/log/tenebra/mainnet.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tenebra-mainnet-candidate /var/log/tenebra

[Install]
WantedBy=multi-user.target
